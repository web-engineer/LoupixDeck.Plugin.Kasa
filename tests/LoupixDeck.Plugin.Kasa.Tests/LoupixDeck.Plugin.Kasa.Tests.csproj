<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests cover the Kasa layer only, which does not touch the host SDK at run time. -->
    <ProjectReference Include="../../LoupixDeck.Plugin.Kasa.csproj" AdditionalProperties="LoupixSkipInstall=true" />
    <!-- The same pretend device the probe's simulator runs. -->
    <Compile Include="../../tools/KasaProbe/Simulation/FakeKasaDevice.cs" LinkBase="Simulation" />
  </ItemGroup>

</Project>
